{
  "identifier": "default",
  "description": "Default capability for hp41-gui — core + Phase 14 IPC commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-take-pending-app-intent",
    "allow-dispatch-op",
    "allow-get-state",
    "allow-sst-step",
    "allow-bst-step",
    "allow-run-stop",
    "allow-request-cancel",
    "allow-submit-modal",
    "allow-cancel-modal",
    "allow-submit-modal-with-label",
    "allow-tick-time",
    "allow-get-prefs",
    "allow-set-pref",
    "allow-restart-app",
    "allow-is-macos",
    "allow-is-ios",
    "allow-save-state",
    "allow-import-raw-dialog",
    "allow-export-raw-dialog",
    "allow-import-data-dialog",
    "allow-export-data-dialog",
    "allow-import-selected-programs",
    "allow-run-program",
    "allow-resume-program",
    "allow-resume-program-with-key",
    "allow-reset-soft",
    "allow-reset-full",
    "dialog:allow-open",
    "dialog:allow-save",
    "autostart:default"
  ]
}
