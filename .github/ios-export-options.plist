<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manual App Store signing for ci-ios.yml. Xcode 26's -allowProvisioningUpdates
	     (Tauri's default export path) returns 401 against ASC, so we export the archive
	     ourselves with this explicit cert + profile. See reference_ios_signing_testflight. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>2P4R8QSWT4</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>ch.talent-factory.hp41</key>
		<string>HP-41 App Store (ci-ios)</string>
	</dict>
	<!-- Keep the build number stamped by `just ios-build-release` / CI instead of letting
	     Xcode pick its own on export. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
